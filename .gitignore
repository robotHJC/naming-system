# 构建产物（用 打包.bat 重新生成，不入库）
dist/

# 测试日志（每次运行测试都会重写）
tests/last-run.txt
tests/lexicon-last-run.txt

# 联网词库的导出文件 —— 里面是第三方数据，不要提交
# （「词库管理」→ 导出数据文件 默认落在 tools/ 或 data/）
tools/naming-lexicon-*.json
data/synced*.json

# 编辑器 / 系统
.vscode/*.local.json
.DS_Store
Thumbs.db
*.log
tools/_msg.txt
tools/_msg2.txt
tools/_msg3.txt

# 数据生成工具的临时产物与下载缓存。
# 缓存里有新华字典 word.json（27MB）和 OpenCC 繁简表，
# 都是第三方数据，跑一次 tools/_gen-chars.js 就会自动重建，绝不要入库。
tools/_gen-cache/
tools/_*-out.txt
tools/_preview.txt
tools/_dbg.txt
tests/*-out.txt

